#. Plugin Name of the plugin
#: listnest.php
msgid "ListNest"
msgstr "ListNest"

#. Description of the plugin
#: listnest.php
msgid "Let customers collect products into custom lists — quote requests, samples, wishlists — and send them with the built-in inquiry form or Contact Form 7."
msgstr "Pozwala klientom zbierać produkty na własnych listach — zapytania ofertowe, próbki, listy życzeń — i wysyłać je wbudowanym formularzem zapytania lub przez Contact Form 7."

