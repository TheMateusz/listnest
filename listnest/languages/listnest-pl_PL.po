msgid "ListNest"
msgstr "ListNest"

msgid "Let customers collect products into custom lists - quote requests, samples, wishlists - and send them with the built-in inquiry form or Contact Form 7."
msgstr "Pozwala klientom zbierać produkty na własnych listach - zapytania ofertowe, próbki, listy życzeń - i wysyłać je wbudowanym formularzem zapytania lub przez Contact Form 7."

msgid "Mateusz Matusiak"
msgstr "Mateusz Matusiak"

msgid "This product cannot be added to the list."
msgstr "Tego produktu nie można dodać do listy."

msgid "Your session has expired. Please reload the page and try again."
msgstr "Twoja sesja wygasła. Odśwież stronę i spróbuj ponownie."

msgid "This list does not exist."
msgstr "Ta lista nie istnieje."

msgid "Please select product options before adding this product to the list."
msgstr "Wybierz opcje produktu, zanim dodasz go do listy."

msgid "The list is full. Remove some products before adding new ones."
msgstr "Lista jest pełna. Usuń część produktów, zanim dodasz nowe."

msgid "The list could not be saved. Please try again."
msgstr "Nie udało się zapisać listy. Spróbuj ponownie."

msgid "Added to the list."
msgstr "Dodano do listy."

msgid "ListNest: this form tag needs the key of a published list, e.g. %s."
msgstr "ListNest: ten znacznik formularza wymaga klucza opublikowanej listy, np. %s."

msgid "No products on the list."
msgstr "Brak produktów na liście."

msgid "× %s"
msgstr "× %s"

msgid "Some products are no longer available. Remove them from your list before sending."
msgstr "Niektóre produkty są już niedostępne. Usuń je z listy przed wysłaniem zapytania."

msgid "Your list is empty. Add at least one product before sending the form."
msgstr "Twoja lista jest pusta. Dodaj co najmniej jeden produkt przed wysłaniem formularza."

msgid "Lists"
msgstr "Listy"

msgid "List"
msgstr "Lista"

msgid "All Lists"
msgstr "Wszystkie listy"

msgid "Add New List"
msgstr "Dodaj nową listę"

