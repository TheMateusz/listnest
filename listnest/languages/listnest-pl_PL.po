#. Plugin Name of the plugin
#: listnest.php
msgid "ListNest"
msgstr "ListNest"

#. Description of the plugin
#: listnest.php
msgid "Let customers collect products into custom lists — quote requests, samples, wishlists — and send them through Contact Form 7."
msgstr "Pozwala klientom zbierać produkty na własnych listach — zapytania ofertowe, próbki, listy życzeń — i wysyłać je przez Contact Form 7."

#. Author of the plugin
#: listnest.php
msgid "Mateusz Matusiak"
msgstr "Mateusz Matusiak"

